APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## Envío real por Google Workspace (para que las notificaciones de "COTIZA ESTA
## JUNTA" lleguen de verdad, no solo al log). Pasos:
## 1. En tu cuenta de Google Workspace (guadalupe.juarez@bombasellos.com.mx),
##    activa la verificación en 2 pasos: myaccount.google.com/security
## 2. Genera una "Contraseña de aplicación": myaccount.google.com/apppasswords
##    (si esa opción no aparece, pide a tu administrador de Workspace que
##    habilite las contraseñas de aplicación para tu cuenta).
## 3. Usa esa contraseña de 16 caracteres como MAIL_PASSWORD (no tu contraseña normal).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=guadalupe.juarez@bombasellos.com.mx
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="guadalupe.juarez@bombasellos.com.mx"
MAIL_FROM_NAME="BSH — Juntas Flexibles"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chatbot con IA (widget "Pregúntale a BSH"). Crea tu API key en
# https://console.anthropic.com — Settings > API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Notificaciones de "COTIZA ESTA JUNTA" (una o varias direcciones separadas por coma).
# Agrega más direcciones (ej. bsh@bombasellos.com.mx) separadas por coma cuando quieras.
QUOTE_NOTIFICATION_EMAILS=guadalupe.juarez@bombasellos.com.mx

# HubSpot: registra cada solicitud de "COTIZA ESTA JUNTA" como contacto + nota,
# para que la tengas disponible en tus listas y campañas de mailing semanales.
# Crea un "Private App" en HubSpot: Configuración > Integraciones > Apps privadas
# > Crear una app privada. Dale estos scopes: crm.objects.contacts.read/write y
# crm.objects.notes.read/write. Copia el token generado aquí abajo.
# Si lo dejas vacío, el sitio sigue funcionando igual, solo se omite este paso.
HUBSPOT_ACCESS_TOKEN=
